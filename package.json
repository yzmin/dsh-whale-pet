{
  "name": "dsh-whale-pet",
  "version": "1.1.3",
  "private": true,
  "description": "An animated DeepSeek blue-whale pet that shows Harness working status, tracks the live context window with dsh-context insight, chimes when work completes, and opens a panel listing every interaction.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "assets/*",
    "locale/*.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
